# oh-my-bmad platform — environment variables.
# Copy to .env and populate. NEVER commit .env (already in .gitignore).
# Rotate secrets by editing .env and running: docker compose up -d (FR48, NFR-S2).
#
# Quoting: values are read as-is by docker compose (NOT through a shell). If a
# value contains `#`, `$`, or spaces, wrap it in double quotes — no backslash
# escaping. Empty values are treated as empty strings, not unset.

# --- Secrets (populate before first run) ---
# Telegram Bot API token — provision via @BotFather on Telegram.
# Consumed by: telegram-gateway.
TELEGRAM_BOT_TOKEN=
# Claude API key for the worker subprocess.
# Consumed by: orchestrator-adapter, worker-wrapper, registry-api (Story 7.3 LLM digest).
ANTHROPIC_API_KEY=
# GitHub personal access token (scope: repo) for PR-draft creation (Story 5.14).
# Consumed by: worker-wrapper.
GITHUB_TOKEN=
# Operator-local HMAC-SHA256 signing key for approval events (FR64 / Epic 11).
# Generate with: `openssl rand -hex 32`  (produces 64 hex chars = 32 bytes).
# When SET, every `approval.granted` event is paired with a `task.approval_signed`
# sibling carrying the HMAC digest (offline-verifiable via `just verify-approval`,
# Story 11.4). When UNSET, signing is skipped and a structured warning is logged
# (approvals remain operational — D2 in Story 11.1 spec).
#
# NFR-S10 isolation — DO NOT:
#   * Commit this value to git (the key is operator-property, never registry-api property)
#   * Log, snapshot, or transmit the key (only the resulting HMAC digest lands in events)
#   * Rotate without a `key.rotated` audit event (Story 11.5 formalizes rotation)
#
# Hot-reload is NOT supported — restart registry-api to pick up a rotated value.
# Consumed by: registry-api (POST /v1/tasks/<id>/decisions handler).
OPERATOR_HMAC_KEY=

# --- Access control ---
# Comma-separated numeric Telegram user IDs allowed to issue commands.
# Consumed by: telegram-gateway's allowlist middleware (Story 3.2).
# WARNING: FAIL-CLOSED. Leaving this empty denies ALL users (the bot becomes
# a read-only ghost). Always populate before enabling the Telegram webhook.
TG_ALLOWLIST_USER_IDS=

# --- Paths & environment ---
# Registry SQLite path INSIDE the container. The macOS overlay rewrites the
# host-side location to ${HOME}/.oh-my-bmad; the container path below stays.
# Consumed by: registry-api, registry-state, worker-wrapper, clawhip-daemon.
REGISTRY_DB_PATH=/var/lib/oh-my-bmad/registry/state.sqlite3
# development | production. `production` disables the FastAPI /v1/docs Swagger UI.
# Consumed by: registry-api (Architecture §Category 3).
ENV=development

# --- Image + upgrade (FR52) ---
# Registry + tag for all 7 platform service images + 1 shared base image.
# Story 1.9's release.yml publishes these to GHCR on `v*` tag push. Bump
# OMB_VERSION to upgrade; run `docker compose pull && docker compose up -d`.
#
# Fork note: update `ghcr.io/r2d2` to your own GHCR owner namespace. The
# release workflow derives this from `${{ github.repository_owner }}` but
# the compose stack pulls from whatever is set here.
#
# OMB_VERSION=dev is LOCAL-ONLY — no GHCR analog exists. Set to a published
# semver tag (e.g. `0.1.0`) before `docker compose pull`, otherwise pull
# errors with `manifest unknown`.
OMB_IMAGE_REGISTRY=ghcr.io/r2d2
OMB_VERSION=dev

# --- Tunnel mode (Phase 1: documentation-only; no code reads this var yet) ---
# Telegram webhook requires HTTPS. The platform does NOT bundle a reverse proxy.
# Pick ONE option and run it on the HOST (not inside compose):
#   cloudflare  — free, zero-config, recommended default.
#                 Example: cloudflared tunnel --url http://localhost:8080
#   ngrok       — free tier sufficient for solo-operator use.
#                 Example: ngrok http 8080
#   byo         — bring-your-own reverse proxy (nginx, Caddy, Traefik).
#                 Operator configures their own TLS termination and forwarding.
TUNNEL_MODE=cloudflare

# --- Telegram webhook (Story 3.1; FR11; architecture.md:217) ---
# Webhook URL exposed by your Cloudflare Tunnel / ngrok / BYO proxy
# to localhost:8080. MUST be https. Architecture §Category 2 line 217.
# The path component MUST match TELEGRAM_WEBHOOK_PATH (default /v1/telegram/webhook).
# Consumed by: telegram-gateway.
TELEGRAM_WEBHOOK_URL=
# Random opaque string Telegram echoes back in the
# `X-Telegram-Bot-Api-Secret-Token` header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be ASCII-printable. Consumed by: telegram-gateway's webhook endpoint.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# --- telegram-gateway server binding (Story 3.1 review-fix M25 / H7) ---
# Audit event log directory. Created at startup if absent; must be writable.
# In Docker: mount a host volume here so events survive container restarts.
# Consumed by: telegram-gateway EventLogWriter.
EVENT_LOG_DIR=/var/lib/oh-my-bmad/events
# Uvicorn bind host. Default 127.0.0.1 (loopback-only, safe on workstations).
# Containers / docker-compose override to 0.0.0.0 so the tunnel can reach
# the service. See TUNNEL_MODE above.
# Consumed by: telegram-gateway uvicorn entrypoint.
TELEGRAM_GATEWAY_HOST=127.0.0.1
# Uvicorn bind port. The tunnel must forward to the same port.
# Consumed by: telegram-gateway uvicorn entrypoint.
TELEGRAM_GATEWAY_PORT=8080

# Allowed Telegram user ids — JSON list. Empty = reject all
# (closed-by-default). Find your id by messaging @userinfobot on
# Telegram. Multiple operators: [12345, 67890].
# Consumed by: telegram-gateway. FR11 / NFR-S4.
TG_ALLOWLIST_USER_IDS=[]

# Registry API base URL for bot → registry HTTP calls.
# Default: docker-compose service name (internal network, HTTP).
# Override for non-compose deployments (e.g., REGISTRY_API_BASE_URL=http://localhost:8080).
# Consumed by: telegram-gateway. FR1 / FR28.
REGISTRY_API_BASE_URL=http://registry-api:8080

# =============================================================================
# Phase 2 Epic 8 — supply-chain verification (Stories 8.1–8.5)
# =============================================================================
# These vars feed the `just verify-images` recipe (Story 8.5), which verifies
# cosign signatures + SLSA L2 attestations + CycloneDX SBOM attestations for
# every Platform-published image BEFORE `docker compose pull`. See
# docs/deployment-guide.md §"Verifying releases" for the full operator
# workflow + cosign-binary installation guidance.

# GitHub repository owner — used by `just verify-images` to construct the
# anchored cert-identity-regexp for cosign verify. Defaults to the canonical
# upstream owner. Override only if you forked + re-published the images.
# Consumed by: just verify-images (Story 8.5). FR56a / NFR-S9.
OMB_GHCR_OWNER=salacoste

# Image content-digests pinned per release. Populate after each release tag
# from the GitHub release notes — they list `<image>@sha256:...` for every
# image. `just verify-images` fails fast if any of these is unset.
# Format: sha256:<64-hex-chars> (include the `sha256:` prefix).
# Consumed by: just verify-images (Story 8.5). FR56.
OMB_IMAGE_DIGEST_base=
OMB_IMAGE_DIGEST_registry_api=
OMB_IMAGE_DIGEST_registry_state=
OMB_IMAGE_DIGEST_telegram_gateway=
OMB_IMAGE_DIGEST_orchestrator_adapter=
OMB_IMAGE_DIGEST_worker_wrapper=
OMB_IMAGE_DIGEST_clawhip_daemon=
OMB_IMAGE_DIGEST_console_cli=

# =============================================================================
# Phase 2 Epic 10 — derived-metrics subscriber (Stories 10.1–10.6)
# =============================================================================
# The `metrics-subscriber` service tails the JSONL event log and exposes a
# Prometheus `/metrics` surface on port 9090 (INTERNAL-ONLY per P2-I5 —
# no host port published; operator scrapes via SSH tunnel or co-located
# Prometheus container on the same docker network). Read-only consumer of
# the shared event log (P2-I1 — registry-state remains sole writer).

# Poll interval (seconds) for the tail loop. Tunable knob: lower values
# give tighter freshness on the /metrics surface at the cost of more
# wakeups; higher values reduce CPU at the cost of staler gauges.
# Default 0.5s matches the Story 10.3 NFR-O8 benchmark assumptions.
# Consumed by: metrics-subscriber.
OMB_METRICS_POLL_INTERVAL_S=0.5

# UID / GID convention — the Dockerfile bakes UID 10008 via `useradd`
# (next free slot after the 10001-10007 assignments for existing
# services). GID 10000 is the shared `omb` group.
#
# P1-L2 review patch (Story 10.6) — documentation only — not consumed
# at runtime; UID baked into Dockerfile via useradd. Present for
# operational reference + future S-4 overlay parity should the overlay
# ever start metrics-subscriber as a future variant. Mirrors the
# OMB_S3_UID / OMB_S3_GID convention used by other services.
# Story 10.6 spec D5 (UID 10003 reservation) was superseded because
# UID 10003 is already taken by telegram-gateway.
OMB_METRICS_UID=10008
OMB_METRICS_GID=10000

# =============================================================================
# Phase 2 Epic 12 — per-task budget policy defaults (Story 12.4 / FR68a)
# =============================================================================
# Each task may carry its own budget policy (token ceiling + action-on-exceed),
# stored on the Task row at submission. When a task omits a field, these .env
# defaults are inherited.
#
# PRECEDENCE (token ceiling):
#   per-task Task-row budget_token_limit
#     > OMB_DEFAULT_TASK_BUDGET_TOKENS            (this section)
#       > ORCHESTRATOR_TASK_TOKEN_BUDGET          (legacy, orchestrator-adapter)
#
# Default per-task token ceiling consumed by orchestrator-adapter's
# BudgetTracker. Unset → falls through to ORCHESTRATOR_TASK_TOKEN_BUDGET
# (default 50000). Set to give every task a larger/smaller default ceiling
# without editing the legacy var. Consumed by: orchestrator-adapter.
# NOTE: because this default takes precedence over the legacy var, the legacy
# "disable enforcement via ORCHESTRATOR_TASK_TOKEN_BUDGET=0" path requires
# UNSETTING this var (otherwise it overrides the 0 with the value below).
OMB_DEFAULT_TASK_BUDGET_TOKENS=50000

# Default per-task action-on-exceed. STORED on the Task row + surfaced via the
# API, but its per-task CONSUMPTION is DEFERRED to Story 12.3a: worker-wrapper
# still enforces the GLOBAL OMB_DEFAULT_BUDGET_ACTION (Story 12.2) until 12.3a
# adds both the per-task delivery channel AND the `awaiting_approval` FSM path.
# Until then every task's effective action is necessarily `failed`. Allowed
# values: failed | awaiting_approval (awaiting_approval is stored-but-inert
# pre-12.3a). Consumed by: registry-api (storage default) — NOT worker-wrapper.
OMB_DEFAULT_TASK_BUDGET_ACTION=failed

# =============================================================================
# Phase 2 Epic 13 — litestream WAL replication sidecar (Story 13.1 / FR69)
# =============================================================================
# DISASTER RECOVERY, NOT HA (replication ≠ HA — see docs/adr/0007). The
# litestream sidecar is OFF by default. To enable it you need BOTH:
#   1. the compose profile:  docker compose --profile litestream up -d litestream
#   2. OMB_LITESTREAM_CONFIG_PATH below pointing at a filled-in litestream.yml
#
# Path (host-side) to your litestream config. Bind-mounted read-only into the
# sidecar at /etc/litestream/litestream.yml.
#   cp litestream.yml.example litestream.yml   # litestream.yml is .gitignored
#   # edit it: pick ONE S3/B2/R2/MinIO block, set bucket/endpoint/region
#   OMB_LITESTREAM_CONFIG_PATH=./litestream.yml
# Leave UNSET to keep replication disabled (the bind mount then falls back to
# ./litestream.yml; if that file is absent, just never enable the profile).
OMB_LITESTREAM_CONFIG_PATH=

# Pinned upstream litestream image tag for the sidecar (no custom image — the
# sidecar is config-not-code per ADR-0007). Bump deliberately.
LITESTREAM_VERSION=0.3.13

# ── litestream object-store CREDENTIALS (Story 13.2 / FR70) ───────────────────
# litestream reads these two standard env vars automatically for s3-type
# replicas, so you do NOT hardcode keys in litestream.yml. The sidecar gets them
# via env_file: .env. KEEP THEM SECRET — .env is gitignored; never commit creds.
#   - AWS S3: an IAM access key with PutObject/GetObject/ListBucket on the bucket.
#   - Backblaze B2: the application keyId / applicationKey.
#   - Cloudflare R2: an R2 API token's access key id / secret.
#   - MinIO: the MinIO access key / secret.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
