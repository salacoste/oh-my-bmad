# oh-my-bmad platform — environment variables.
# Copy to .env and populate. NEVER commit .env (already in .gitignore).
# Rotate secrets by editing .env and running: docker compose up -d (FR48, NFR-S2).

# --- Secrets (populate before first run) ---
# Telegram Bot API token — provision via @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Claude API key for the worker subprocess.
ANTHROPIC_API_KEY=
# GitHub personal access token (scope: repo) for PR-draft creation (Story 5.14).
GITHUB_TOKEN=

# --- Access control ---
# Comma-separated numeric Telegram user IDs allowed to issue commands.
# Consumed by telegram-gateway's allowlist middleware (Story 3.2).
TG_ALLOWLIST_USER_IDS=

# --- Paths & environment ---
# Registry SQLite path (Linux default). macOS overlay maps the data dir to
# ${HOME}/.oh-my-bmad — the path below is still valid INSIDE the container.
REGISTRY_DB_PATH=/var/lib/oh-my-bmad/registry/state.sqlite3
# development | production. `production` disables the FastAPI /v1/docs Swagger UI.
ENV=development

# --- Tunnel mode (Phase 1: documentation-only; no code reads this var yet) ---
# Telegram webhook requires HTTPS. The platform does NOT bundle a reverse proxy.
# Pick ONE option and run it on the HOST (not inside compose):
#   cloudflare  — free, zero-config, recommended default.
#                 Example: cloudflared tunnel --url http://localhost:8080
#   ngrok       — free tier sufficient for solo-operator use.
#                 Example: ngrok http 8080
#   byo         — bring-your-own reverse proxy (nginx, Caddy, Traefik).
#                 Operator configures their own TLS termination and forwarding.
TUNNEL_MODE=cloudflare
