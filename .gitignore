# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/
ENV/
env/

# uv
.uv/

# Test + lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Environment files (keep .env.example, ignore real secrets)
.env
*.env
!.env.example

# Repo-local data dirs (Phase 1 platform data lives in the system path
# /var/lib/oh-my-bmad/, which is outside the repo. This rule guards against
# any future repo-local var/ symlink or accidental commit.)
/var/

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*~

# Operator session ephemeral runtime state — never tracked
# (paths, costs, session UUIDs, etc. — Claude Code, OMC, and similar harnesses)
.omc/
.claude/sessions/
.claude/state/
