# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/
ENV/
env/

# uv
.uv/

# Test + lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Environment files (keep .env.example, ignore real secrets).
# Narrow pattern: repo-root `.env` only, so `docs/deployment/foo.env.template`
# (or similar committed templates) won't be silently ignored.
/.env
!.env.example

# Repo-local data dirs (Phase 1 platform data lives in the system path
# /var/lib/oh-my-bmad/, which is outside the repo. This rule guards against
# any future repo-local var/ symlink or accidental commit.)
/var/

# Private key files (defense-in-depth — none in repo today)
*.pem
*.key
*.p12
*.pfx
*.jks

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*~

# Operator session ephemeral runtime state — never tracked
# (paths, costs, session UUIDs, etc. — Claude Code, OMC, and similar harnesses)
.omc/
.claude/sessions/
.claude/state/

# Scratch sandbox used by `just migrator-test-additive` and similar recipes.
# Recipe cleans up on success; this rule catches failed/interrupted runs.
.tmp/

# Story 2.11 crash-injection summary artifacts — generated by CI, not committed.
_bmad-output/test-artifacts/*.json

# Marketing drafts (articles, X threads, etc.) — local only, not for repo.
marketing/

# Playwright MCP page-snapshot artifacts — transient CI-debug dumps.
.playwright-mcp/

# Story 13.2 — operator's filled-in litestream config MAY hold credentials.
# The committed template is litestream.yml.example; the real file is local-only.
litestream.yml

# Story 14.2 — cosmic-ray mutation-testing session databases + artifacts.
# `cosmic-ray init` writes a SQLite session db (the "work order" + results);
# the smoke/full recipes name them mutation-*.sqlite. These are generated,
# can be large, and must never be committed. (cosmic-ray restores mutated
# source from VCS after each mutant, so no source diff should ever leak.)
*.sqlite
*.sqlite-journal
.cosmic-ray/
