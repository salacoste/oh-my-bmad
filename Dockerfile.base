# Dockerfile.base — shared multi-stage template for every Python service image.
#
# Build via:
#   docker build -f Dockerfile.base --target runtime-base -t oh-my-bmad-base:local .
# Or via the justfile recipe:
#   just build-base
#
# Per-service Dockerfiles extend via `FROM oh-my-bmad-base:local` + `useradd` +
# `USER` + `ENTRYPOINT`. See `services/*/Dockerfile` for the thin overrides.
#
# Requires BuildKit (Docker Engine ≥ 23 has it enabled by default; older
# versions need `DOCKER_BUILDKIT=1`).
#
# Architecture §line-244 mandate: venv at `/opt/venv`, runtime stage carries
# only the venv (not the workspace source tree). `--no-editable` on `uv sync`
# makes this possible by installing every workspace member as a built wheel
# rather than an editable link back to `/app/services/<name>/src`.
#
# Story 1.9 (GHCR image publishing) must coordinate the base-image dependency:
# per-service Dockerfiles `FROM oh-my-bmad-base:local` and GHCR buildx workers
# have no such local tag. Story 1.9's release.yml will either (a) build the
# base in-workflow, (b) push the base to GHCR as `oh-my-bmad-base:<version>`
# and retag the per-service FROMs, or (c) use buildx `additional_contexts` to
# inject a build-time base context. Noted here so the hand-off is explicit.

# ─── Stage 1: venv-builder ─────────────────────────────────────────────────
# Installs uv + syncs every workspace member into /opt/venv as built wheels.
# `--no-dev` skips pytest/ruff/mypy/hypothesis/structlog-from-dev-group (but
# structlog IS a runtime dep of secret-hygiene and ships via its own
# pyproject.toml). `--no-editable` installs workspace packages as wheels so
# the source tree is NOT needed in the runtime image.
FROM python:3.12-slim-bookworm AS venv-builder
RUN pip install --no-cache-dir uv==0.11.*
WORKDIR /build
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
COPY services/ ./services/
COPY mcp-servers/ ./mcp-servers/
COPY src/ ./src/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
RUN uv sync --frozen --no-dev --all-packages --no-editable

# ─── Stage 2: runtime-base ─────────────────────────────────────────────────
# Final runtime foundation. Each per-service Dockerfile adds a unique user +
# entrypoint. Shared `omb` group (GID 10000) owns `/app` (group-writable) so
# service users can write runtime state (logs, caches, SQLite WAL) under
# their home dir without a per-service chown step.
#
# Story 11.3.5: also pre-create the `/var/lib/oh-my-bmad` data root group-owned
# by `omb` + setgid-group-writable (2775), mirroring the `/app` pattern. Docker
# seeds a FRESH named volume from the image's directory ownership at the mount
# path; without this the volume mounts ROOT-owned and registry-state (uid 10002,
# gid omb) cannot write -> lifespan never touches /tmp/ready -> "unhealthy"
# (the S-4 separability Phase-1 ROOT-compose failure; Fix-B's bind-mount uid
# override does NOT apply to the named volume). setgid (the leading 2) makes
# subdirs/files registry-state/migrator create inherit the omb group so EVERY
# omb-group service can read/write regardless of its per-service uid. Benefits
# fresh-named-volume production deploys too, not just the S-4 test.
FROM python:3.12-slim-bookworm AS runtime-base
# TLS / https support for services that call external APIs (Anthropic,
# Telegram, GitHub, Node subprocesses, etc.).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && pip uninstall -y pip setuptools wheel 2>/dev/null || true
# Shared group; per-service users land in each service's Dockerfile.
RUN groupadd --system --gid 10000 omb \
 && mkdir -p /app \
 && chgrp omb /app \
 && chmod 2775 /app \
 && mkdir -p /var/lib/oh-my-bmad \
 && chgrp omb /var/lib/oh-my-bmad \
 && chmod 2775 /var/lib/oh-my-bmad
WORKDIR /app
# Copy ONLY the venv (not source — wheels built by --no-editable contain
# the code already) from the builder.
COPY --from=venv-builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
# Entrypoint + USER are set by each per-service Dockerfile.
