      "server SAN must match REGISTRY_DB_MTLS_SERVER_HOSTNAME for verify-full",
      "server certificate must be validated by registry-state client before connection"
    ],
    "client_profile": [
      "registry-state client certificate must chain to approved client CA",
      "client certificate is scoped to the application role and database",
      "client private key uses mode and owner evidence checks"
    ],
    "hostname_policy": "verify-full Postgres hostname/SAN matching is mandatory when DB mTLS is enabled"
  },
  "approved_secret_locations": {
    "status": "contract_required",
    "approved_prefixes": [
      "/run/secrets/",
      "/certs/db/"
    ],
    "test_only_prefix_policy": "temporary fixture directories require an explicit test-only override and are forbidden in production docs",
    "canonical_resolution": "realpath_under_approved_prefix",
    "symlink_escape_policy": "reject",
    "private_key_permission_policy": "reject_group_or_world_readable",
    "owner_expectation": "secret-mounted keys must record expected owner/group without mutating live hosts during local validation",
    "example_paths": [
      "/run/secrets/db-material",
      "/certs/db/material"
    ]
  },
  "env_config_keys": {
